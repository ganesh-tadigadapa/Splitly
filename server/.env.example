# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

# MongoDB connection string (local or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/splitDB

# Port the API listens on. The client expects 5001 by default.
PORT=5001

# Google Gemini API key. Without it, AI features fall back to offline replies.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI key (or a Groq key starting with gsk_), used by the chatbot
# only when no Gemini key is set.
OPENAI_API_KEY=your_openai_api_key_here

# Secret used to sign login tokens. Use a long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, the server uses a random secret that changes on every restart.
JWT_SECRET=
